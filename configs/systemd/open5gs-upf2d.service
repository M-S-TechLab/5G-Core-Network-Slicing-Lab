[Unit]
Description=Open5GS UPF Daemon (SST 2 - URLLC)
Documentation=https://open5gs.org/open5gs/docs/
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/open5gs-upfd -c /etc/open5gs/upf-sst2.yaml
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
